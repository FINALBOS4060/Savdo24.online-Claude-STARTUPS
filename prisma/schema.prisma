datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String?
  name            String
  role            String    // "Sotuvchi" or "Xaridor" or "Admin"
  googleId        String?   @unique
  authProvider    String    @default("email") // "email" | "google"
  verified        Boolean   @default(false)
  joinDate        DateTime  @default(now())
  avatarUrl       String
  coverUrl        String?
  phone           String?
  signupReferralCode String?
  walletConnected Boolean   @default(false)
  walletAddress   String?
  emailVerified   Boolean   @default(false)
  verificationToken String?
  resetToken       String?
  resetTokenExpiry DateTime?
  averageRating   Float     @default(0)
  totalReviews    Int       @default(0)
  isBanned        Boolean   @default(false)
  isVip           Boolean   @default(false)
  vipExpiresAt    DateTime?
  vipExpiryNotifiedAt DateTime? // VIP tugashiga 1-2 kun qolgani haqida eslatma yuborilgan payt (takroriy yubormaslik uchun)
  vipExpiredNotifiedAt DateTime? // VIP muddati tugagani haqida xabar yuborilgan payt (takroriy yubormaslik uchun)
  telegramBroadcastOptOut Boolean @default(false) // true bo'lsa, admin broadcast/reklama xabarlarini olmaydi (xarid/nizo kabi muhim xabarlar bunga bog'liq emas)
  telegramBotBlockedAt DateTime? // Telegram 403 ("bot was blocked by the user") qaytarganda shu vaqt yoziladi.
                                 // null = bloklamagan. Muvaffaqiyatli xabar yetkazilganda avtomatik
                                 // tozalanadi (foydalanuvchi botni qayta ochgan bo'lsa). Broadcast so'rovlari
                                 // shu maydon bo'yicha filtrlanadi — bloklagan foydalanuvchilarga qayta-qayta
                                 // urinilmaydi.
  telegramUserId  String?   @unique
  telegramLinkCode String?   @unique
  telegramLinkCodeExpires DateTime?
  startups        Startup[]
  payments        Payment[]
  ideas           Idea[]
  reviewsWritten  Review[]  @relation("BuyerReviews")
  disputes        Dispute[] @relation("BuyerDisputes")
  refreshTokens   RefreshToken[]
  buyerConversations Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  vipSubscriptions VipSubscription[]
  referrals          Referral[] @relation("ReferrerReferrals")
  referredBy         Referral[] @relation("RefereeReferrals")
  b2bAccount         B2BAccount?
  auditLogs          AuditLog[]
  broadcastMessages  BroadcastMessage[]
  proposedCategories Category[]

  @@index([role])
  @@index([isBanned])
  @@index([joinDate])
  @@index([telegramBotBlockedAt])
}

model Category {
  id                String    @id
  name              String
  icon              String
  fields            String?
  status            String    @default("active") // "active" | "pending" — foydalanuvchi taklif qilgan kategoriyalar admin tasdiqlaguncha "pending" bo'ladi
  proposedByUserId  Int?
  proposedByUser    User?     @relation(fields: [proposedByUserId], references: [id])
  createdAt         DateTime  @default(now())

  @@index([status])
}

model Startup {
  id              String    @id
  name            String
  slogan          String
  description     String
  longDescription String
  category        String
  price           Decimal   @default(0) @db.Decimal(12, 2)
  listingType     String    @default("To'liq loyiha (manba kodi bilan)")
  techStack       String    @default("[]") // Serialized JSON array of strings
  demoUrl         String?
  githubUrl       String?
  repoIncluded    Boolean   @default(false)
  soldStatus      String    @default("sotuvda") // "sotuvda" | "sotildi"
  status          String    @default("pending") // "active" | "pending"
  proposalsCount  Int       @default(0)
  attributes      String    @default("{}") // Kategoriyaga qarab har xil JSON obyekt
  image           String
  gallery         String    // Serialized JSON array of strings
  team            String    // Serialized JSON array of TeamMember objects
  milestones      String    // Serialized JSON array of milestones
  deliveryUrl     String?
  contactEmail    String?
  contactPhone    String?
  contactTelegram String?
  dateCreated     String?
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
  isTop           Boolean   @default(false)
  topExpiresAt    DateTime?
  topExpiryNotifiedAt DateTime? // TOP tugashiga 1-2 kun qolgani haqida eslatma yuborilgan payt
  topExpiredNotifiedAt DateTime? // TOP muddati tugagani haqida xabar (qayta faollashtirish taklifi) yuborilgan payt
  ideas           Idea[]
  payments        Payment[]
  reviews         Review[]
  conversations   Conversation[]
  topBoosts       TopBoost[]
  currentTier     String     @default("standard")
  subscriptions   ListingSubscription[]
  updatedAt       DateTime   @updatedAt

  @@index([category])
  @@index([status])
  @@index([soldStatus])
  @@index([status, category])
  @@index([status, isTop, id])
}

model Payment {
  id                 String    @id // orderId or standard id
  amount             Decimal  @db.Decimal(12, 2)
  status             String    // "pending" | "completed" | "failed"
  currency           String    @default("USDT")
  createdAt          DateTime  @default(now())
  // TUZATISH: server.ts'dagi checkPendingRefunds() (har kuni 08:00 cron)
  // "refund_required" holatida 3 kundan ortiq turgan to'lovlarni topish
  // uchun Payment.updatedAt maydonidan foydalanardi, lekin bu maydon
  // sxemada UMUMAN mavjud emas edi — natijada Prisma har safar xato
  // tashlab, butun eslatma funksiyasi (adminlarga kechiktirilgan
  // qaytarishlar haqida ogohlantirish) har kuni jimgina ishlamay qolardi.
  updatedAt          DateTime  @updatedAt
  callbackToken      String?
  platformFeeAmount  Decimal?    @default(0) @db.Decimal(12, 2)
  sellerPayoutAmount Decimal?    @default(0) @db.Decimal(12, 2)
  userId             Int?
  user               User?    @relation(fields: [userId], references: [id])
  startupId          String?
  startup            Startup?  @relation(fields: [startupId], references: [id])
  gateway            String    @default("coingate")
  source             String    @default("web") // "web" | "telegram"
  referralId         String?
  disputes           Dispute[]
  escrow             EscrowPayment?

  @@index([userId])
  @@index([status])
}

model Idea {
  id          Int      @id @default(autoincrement())
  content     String        // g'oya matni (komment)
  startupId   String
  startup     Startup  @relation(fields: [startupId], references: [id])
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  authorName  String   // agar login qilmagan bo'lsa ham ism kiritsin
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([startupId])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model IdeaVote {
  id        Int      @id @default(autoincrement())
  ideaId    Int
  voterKey  String   // login qilgan bo'lsa userId, aks holda IP+browser fingerprint kombinatsiyasi
  createdAt DateTime @default(now())

  @@unique([ideaId, voterKey])
}

model Review {
  id          Int      @id @default(autoincrement())
  rating      Int      // 1 dan 5 gacha
  comment     String
  startupId   String
  startup     Startup  @relation(fields: [startupId], references: [id])
  buyerId     Int
  buyer       User     @relation(fields: [buyerId], references: [id], name: "BuyerReviews")
  sellerId    Int      // sotuvchini alohida ko'rsatish uchun
  createdAt   DateTime @default(now())

  @@unique([startupId, buyerId])
  @@index([sellerId])
}

model Dispute {
  id          Int      @id @default(autoincrement())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  buyerId     Int
  buyer       User     @relation(fields: [buyerId], references: [id], name: "BuyerDisputes")
  reason      String
  description String
  status      String   @default("open") // "open" | "reviewing" | "resolved" | "rejected"
  adminNote   String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@unique([paymentId])
  @@index([status])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id          Int      @id @default(autoincrement())
  targetType  String   // "startup" | "idea" | "user"
  targetId    String
  reporterId  Int
  reason      String
  description String?
  status      String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt   DateTime @default(now())

  // MUHIM: avval bu yerda unikal cheklov yo'q edi — src/routes/support.ts'dagi
  // "avval qidir, keyin qo'sh" (findFirst + create) tekshiruvi ilova darajasida
  // ishlaydi, lekin bu poyga holatiga (race condition) qarshi himoyasiz: ikkita
  // bir vaqtdagi so'rov ikkalasi ham "hali yo'q" deb topib, bitta foydalanuvchi
  // bitta targetga ikkita bir xil shikoyat yaratib qo'yishi mumkin edi. Loyihada
  // IdeaVote kabi boshqa modellarda xuddi shu maqsadda @@unique ishlatilgan —
  // endi Report ham shu konventsiyaga muvofiqlashtirildi.
  @@unique([reporterId, targetId, targetType])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  adminEmail String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String   // "approve_startup" | "reject_startup" | "resolve_dispute" | "delete_report" va h.k.
  targetType String?
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}

// YANGI: ommaviy (broadcast) xabarlar tarixi. Ilgari natija (jami/
// yuborilgan/xato) faqat frontend local state'da turardi va sahifa
// yangilansa yo'qolardi, audit logda esa faqat statistika saqlanib,
// xabarning O'ZI (matni) hech qayerda saqlanmasdi — bu degani admin
// oldin nima yozganini keyinroq ko'ra olmasdi. Endi har bir broadcast
// so'rov boshlanishi bilanoq shu jadvalga "running" holatida yoziladi
// (shu bilan server qayta ishga tushsa ham — masalan deploy paytida —
// "running" holatida "yarim qolgan" job tarixda ko'rinadi, xotiradagi
// Map'dagidek butunlay yo'qolib qolmaydi), so'ng fonda progress
// yangilanadi va yakunda "done" qilinadi.
model BroadcastMessage {
  id          Int      @id @default(autoincrement())
  message     String
  adminId     Int?
  adminEmail  String?
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  total       Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  status      String   @default("running") // "running" | "done"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([adminId])
  @@index([startedAt])
}

model Setting {
  key         String   @id
  value       String   // AES-256-GCM bilan shifrlangan
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

// New model to store which news URLs were already posted by the bot
model TechNewsPost {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  title     String?
  source    String?
  postedAt  DateTime @default(now())
}

model TelegramDelivery {
  id             String   @id @default(uuid())
  token          String   @unique  // bir martalik, taxminan qilib bo'lmaydigan token
  paymentId      String?
  startupId      String
  telegramUserId String?  // bog'langandan keyin to'ldiriladi
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
}

model SponsorChannel {
  id                Int      @id @default(autoincrement())
  channelId         String   // Telegram kanal ID (masalan -1001234567890)
  channelUsername   String   // @kanalnomi (foydalanuvchiga ko'rsatish uchun)
  displayName       String
  isActive          Boolean  @default(true)
  advertiserContact String?  // kanal egasining kontakti (ichki eslatma uchun)
  pricePerMonth     Decimal?   @db.Decimal(12, 2)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
}
