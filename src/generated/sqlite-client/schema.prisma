datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite-client"
}

model User {
  id                      Int               @id @default(autoincrement())
  email                   String            @unique
  password                String?
  name                    String
  role                    String // "Sotuvchi" or "Xaridor" or "Admin"
  googleId                String?           @unique
  authProvider            String            @default("email") // "email" | "google"
  verified                Boolean           @default(false)
  joinDate                String
  avatarUrl               String
  coverUrl                String?
  walletConnected         Boolean           @default(false)
  walletAddress           String?
  emailVerified           Boolean           @default(false)
  verificationToken       String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  averageRating           Float             @default(0)
  totalReviews            Int               @default(0)
  isBanned                Boolean           @default(false)
  isVip                   Boolean           @default(false)
  vipExpiresAt            DateTime?
  telegramUserId          String?           @unique
  telegramLinkCode        String?           @unique
  telegramLinkCodeExpires DateTime?
  startups                Startup[]
  payments                Payment[]
  ideas                   Idea[]
  reviewsWritten          Review[]          @relation("BuyerReviews")
  disputes                Dispute[]         @relation("BuyerDisputes")
  refreshTokens           RefreshToken[]
  buyerConversations      Conversation[]    @relation("BuyerConversations")
  sellerConversations     Conversation[]    @relation("SellerConversations")
  vipSubscriptions        VipSubscription[]
  referrals               Referral[]        @relation("ReferrerReferrals")
  referredBy              Referral[]        @relation("RefereeReferrals")
  b2bAccount              B2BAccount?
  auditLogs               AuditLog[]

  @@index([role])
  @@index([isBanned])
  @@index([joinDate])
}

model Category {
  id     String  @id
  name   String
  icon   String
  fields String?
}

model Startup {
  id              String                @id
  name            String
  slogan          String
  description     String
  longDescription String
  category        String
  price           Decimal               @default(0)
  listingType     String                @default("To'liq loyiha (manba kodi bilan)")
  techStack       String                @default("[]") // Serialized JSON array of strings
  demoUrl         String?
  githubUrl       String?
  repoIncluded    Boolean               @default(false)
  soldStatus      String                @default("sotuvda") // "sotuvda" | "sotildi"
  status          String                @default("pending") // "active" | "pending"
  proposalsCount  Int                   @default(0)
  attributes      String                @default("{}") // Kategoriyaga qarab har xil JSON obyekt
  image           String
  gallery         String // Serialized JSON array of strings
  team            String // Serialized JSON array of TeamMember objects
  milestones      String // Serialized JSON array of milestones
  deliveryUrl     String?
  contactEmail    String?
  contactPhone    String?
  contactTelegram String?
  dateCreated     String?
  userId          Int?
  user            User?                 @relation(fields: [userId], references: [id])
  isTop           Boolean               @default(false)
  topExpiresAt    DateTime?
  ideas           Idea[]
  payments        Payment[]
  reviews         Review[]
  conversations   Conversation[]
  topBoosts       TopBoost[]
  currentTier     String                @default("standard")
  subscriptions   ListingSubscription[]
  updatedAt       DateTime              @updatedAt

  @@index([category])
  @@index([status])
  @@index([soldStatus])
  @@index([status, category])
  @@index([status, isTop, id])
}

model Payment {
  id                 String         @id // orderId or standard id
  amount             Decimal
  status             String // "pending" | "completed" | "failed"
  currency           String         @default("USDT")
  createdAt          DateTime       @default(now())
  callbackToken      String?
  platformFeeAmount  Decimal?       @default(0)
  sellerPayoutAmount Decimal?       @default(0)
  userId             Int?
  user               User?          @relation(fields: [userId], references: [id])
  startupId          String?
  startup            Startup?       @relation(fields: [startupId], references: [id])
  gateway            String         @default("coingate")
  source             String         @default("web")
  referralId         String?
  disputes           Dispute[]
  escrow             EscrowPayment?

  @@index([userId])
  @@index([status])
}

model Idea {
  id         Int      @id @default(autoincrement())
  content    String // g'oya matni (komment)
  startupId  String
  startup    Startup  @relation(fields: [startupId], references: [id])
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String // agar login qilmagan bo'lsa ham ism kiritsin
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([startupId])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model IdeaVote {
  id        Int      @id @default(autoincrement())
  ideaId    Int
  voterKey  String // login qilgan bo'lsa userId, aks holda IP+browser fingerprint kombinatsiyasi
  createdAt DateTime @default(now())

  @@unique([ideaId, voterKey])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1 dan 5 gacha
  comment   String
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  buyerId   Int
  buyer     User     @relation(fields: [buyerId], references: [id], name: "BuyerReviews")
  sellerId  Int // sotuvchini alohida ko'rsatish uchun
  createdAt DateTime @default(now())

  @@index([startupId])
  @@index([sellerId])
}

model Dispute {
  id          Int       @id @default(autoincrement())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id])
  buyerId     Int
  buyer       User      @relation(fields: [buyerId], references: [id], name: "BuyerDisputes")
  reason      String
  description String
  status      String    @default("open") // "open" | "reviewing" | "resolved" | "rejected"
  adminNote   String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([paymentId])
  @@index([status])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id          Int      @id @default(autoincrement())
  targetType  String // "startup" | "idea" | "user"
  targetId    String
  reporterId  Int
  reason      String
  description String?
  status      String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt   DateTime @default(now())

  // PostgreSQL sxemasidagi (schema.prisma) bilan bir xil sabab: bitta
  // foydalanuvchi bitta targetga ikki marta shikoyat qoldirishining oldini
  // olish uchun. Ikkala sxema doim bir-biriga muvofiq bo'lishi shart.
  @@unique([reporterId, targetId, targetType])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  adminEmail String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String // "approve_startup" | "reject_startup" | "resolve_dispute" | "delete_report" va h.k.
  targetType String?
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}

model Setting {
  key         String   @id
  value       String // AES-256-GCM bilan shifrlangan
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

model TelegramDelivery {
  id             String   @id @default(uuid())
  token          String   @unique // bir martalik, taxminan qilib bo'lmaydigan token
  paymentId      String?
  startupId      String
  telegramUserId String? // bog'langandan keyin to'ldiriladi
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
}

model SponsorChannel {
  id                Int       @id @default(autoincrement())
  channelId         String // Telegram kanal ID (masalan -1001234567890)
  channelUsername   String // @kanalnomi (foydalanuvchiga ko'rsatish uchun)
  displayName       String
  isActive          Boolean   @default(true)
  advertiserContact String? // kanal egasining kontakti (ichki eslatma uchun)
  pricePerMonth     Decimal?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
}

model TopBoost {
  id        String   @id @default(uuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  userId    Int
  days      Int
  pricePaid Decimal
  startsAt  DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VipSubscription {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  days      Int
  pricePaid Decimal
  startsAt  DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id            String    @id @default(uuid())
  startupId     String?
  startup       Startup?  @relation(fields: [startupId], references: [id])
  buyerId       Int
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId      Int
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([startupId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Referral {
  id                String           @id @default(uuid())
  referrerId        Int
  referrer          User             @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  refereeId         Int?
  referee           User?            @relation("RefereeReferrals", fields: [refereeId], references: [id])
  code              String           @unique
  discountPercent   Float            @default(5)
  commissionPercent Float            @default(5)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  rewards           ReferralReward[]

  @@index([referrerId])
}

model ReferralReward {
  id           String   @id @default(uuid())
  referralId   String
  referral     Referral @relation(fields: [referralId], references: [id])
  paymentId    String?
  rewardAmount Decimal
  status       String   @default("pending") // pending, earned, paid_out
  createdAt    DateTime @default(now())

  @@index([referralId])
  @@index([paymentId])
}

model ListingTier {
  id            String                @id @default(uuid())
  tier          String                @unique // "standard" | "featured" | "premium"
  displayName   String // "Standard" | "Featured (TOP)" | "Premium Plus"
  pricePerDay   Decimal
  durationDays  Int                   @default(7)
  features      String // JSON string: visibility_boost, priority, icon, etc
  createdAt     DateTime              @default(now())
  subscriptions ListingSubscription[]
}

model ListingSubscription {
  id        String      @id @default(uuid())
  startupId String
  startup   Startup     @relation(fields: [startupId], references: [id])
  tierId    String
  tier      ListingTier @relation(fields: [tierId], references: [id])
  paymentId String?
  startsAt  DateTime    @default(now())
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

model EscrowPayment {
  id          String              @id @default(uuid())
  paymentId   String              @unique
  payment     Payment             @relation(fields: [paymentId], references: [id])
  status      String              @default("held") // held, released, refunded, disputed
  releasedAt  DateTime?
  holdEndDate DateTime // auto-release after buyer confirms or timeout
  createdAt   DateTime            @default(now())
  disputes    DisputeResolution[]

  @@index([status])
}

model DisputeResolution {
  id         String        @id @default(uuid())
  escrowId   String
  escrow     EscrowPayment @relation(fields: [escrowId], references: [id])
  reason     String
  evidence   String // JSON array of file URLs
  adminNote  String?
  resolution String        @default("pending") // pending, released, refunded, split
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
}

model B2BAccount {
  id           String     @id @default(uuid())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  companyName  String
  taxId        String?
  verified     Boolean    @default(false)
  discount     Decimal    @default(20)
  monthlyLimit Decimal    @default(10000)
  spent        Decimal    @default(0)
  createdAt    DateTime   @default(now())
  orders       B2BOrder[]
}

model B2BOrder {
  id         String     @id @default(uuid())
  b2bId      String
  b2b        B2BAccount @relation(fields: [b2bId], references: [id])
  startupIds String // JSON array of IDs
  totalPrice Decimal
  discount   Decimal
  paymentId  String?
  status     String     @default("pending")
  createdAt  DateTime   @default(now())
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  event     String // user_signup, listing_view, etc.
  userId    Int?
  targetId  String?
  source    String?
  device    String?
  metadata  String   @default("{}") // JSON metadata
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(uuid())
  email     String
  subject   String
  message   String
  status    String   @default("pending") // pending, reviewing, resolved, closed
  createdAt DateTime @default(now())
}

// MUHIM: server.ts'da `prisma.notification` ko'p joyda ishlatiladi, lekin
// bu model avval sxemada umuman yo'q edi. Endi qo'shildi (schema.prisma
// bilan bir xil).
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
